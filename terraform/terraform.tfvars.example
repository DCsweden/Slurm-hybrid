project_name   = "slurm-hybrid"
aws_region     = "eu-north-1"
gcp_project_id = "your-gcp-project-id"
gcp_region     = "europe-north2"
gcp_zone       = "europe-north2-a"

ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"

# Restrict in production
allowed_ssh_cidr = "203.0.113.0/32"

slurm_version = "24.05.3"

instance_type_login      = "t3.medium"
instance_type_controller = "t3.medium"
instance_type_aws_compute = "t3.large"
instance_type_gcp_compute = "n2-standard-4"
