#!/bin/bash
# Slurm SuspendProgram — stop cloud VMs to save power
# https://slurm.schedmd.com/power_save.html

set -euo pipefail

NODE_LIST="${1:-}"
if [[ -z "$NODE_LIST" ]]; then
  echo "Usage: $0 <hostlist>" >&2
  exit 1
fi

CONFIG="/etc/slurm/cloud-nodes.json"

expand_nodes() {
  local list="$1"
  if command -v scontrol >/dev/null 2>&1; then
    scontrol show hostnames "$list" 2>/dev/null || echo "$list"
  else
    echo "$list" | tr ',' '\n'
  fi
}

lookup() {
  local node="$1" field="$2"
  jq -r --arg n "$node" --arg f "$field" '.[$n][$f] // empty' "$CONFIG"
}

for node in $(expand_nodes "$NODE_LIST"); do
  provider=$(lookup "$node" provider)
  instance_id=$(lookup "$node" instance_id)
  zone=$(lookup "$node" zone)

  echo "Suspending $node ($provider: $instance_id)"

  case "$provider" in
    aws)
      aws ec2 stop-instances --instance-ids "$instance_id" --output text
      ;;
    gcp)
      gcloud compute instances stop "$instance_id" --zone="${zone}" --quiet
      ;;
    *)
      echo "Unknown provider: $provider" >&2
      exit 1
      ;;
  esac
done

exit 0
